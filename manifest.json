{
  "manifest_version": 3,
  "name": "YouTube Chat Dock",
  "version": "1.3.0",
  "description": "Turn live chat and chat replay into a resizable side panel. Drag the divider to resize. Works in true fullscreen. No permissions.",
  "homepage_url": "https://github.com/cc100053/YouTube-Chat-Dock",
  "minimum_chrome_version": "88",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "css": [
        "dock.css"
      ],
      "js": [
        "dock.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
